{
  "$schema": "https://json.schemastore.org/package.json",
  "name": "interview-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev:api": "wrangler dev --port 8787",
    "dev:web": "vite",
    "build": "vue-tsc --noEmit && vite build",
    "deploy": "npm run build && wrangler deploy",
    "db:migrate": "wrangler d1 execute interview --local --file=./api/src/db/schema.sql",
    "db:migrate:remote": "wrangler d1 execute interview --remote --file=./api/src/db/schema.sql",
    "db:seed": "wrangler d1 execute interview --local --file=./import/seed.sql",
    "typecheck": "tsc --noEmit -p api/tsconfig.json",
    "test": "node --test test/*.test.ts"
  },
  "dependencies": {
    "hono": "^4.6.0",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261104.1",
    "@vitejs/plugin-vue": "^5.2.0",
    "typescript": "^5.6.0",
    "vite": "^6.0.0",
    "vue": "^3.5.0",
    "vue-router": "^4.4.0",
    "vue-tsc": "^2.1.0",
    "pinia": "^2.2.0",
    "wrangler": "^4.0.0"
  }
}

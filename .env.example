# 环境变量示例
#
# 复制这份文件，把值填进对应位置。真正的密钥不要提交到仓库。
#
# 分成两类：
#   1) 普通变量 → 写在 wrangler.toml 的 [vars]，或本地 .dev.vars
#   2) 密钥     → 用 `npx wrangler secret put <NAME>`，本地放 .dev.vars

# ── 普通变量（wrangler.toml [vars]）──────────────────────
# 站点 origin，OAuth 回跳和登录跳转都基于它
APP_ORIGIN="https://interview.<your-subdomain>.workers.dev"

# 邮箱登录开关：需要已备案/可验证的发信域名，默认关闭
AUTH_EMAIL_ENABLED="false"

# GitHub OAuth App 的 Client ID（公开信息）
GITHUB_CLIENT_ID=""

# ── 密钥（wrangler secret put，切勿提交）──────────────────
# 会话签名密钥，至少 32 字节随机串：
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=""

# GitHub OAuth App 的 Client Secret
GITHUB_CLIENT_SECRET=""

# ── 本地开发（.dev.vars，已 gitignore）────────────────────
# 本地优先读 .dev.vars，可覆盖上面的值：
#   APP_ORIGIN="http://127.0.0.1:8787"
#   JWT_SECRET="local-dev-secret-do-not-deploy"
